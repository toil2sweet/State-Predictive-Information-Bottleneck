#!/usr/bin/env bash
#PBS -N spib-probe
#PBS -P 11014454
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=16gb:ngpus=1
#PBS -l walltime=00:05:00
#PBS -j oe

# Minimal scheduler/environment probe. It allocates one GPU, verifies the SPIB
# environment and CUDA, writes a persistent log, and performs no training.

set -euo pipefail

PROJECT_ROOT="${NSCC_PROJECT_ROOT:-/data/projects/11014454/depeng}"
ENV_PREFIX="${NSCC_ENV_PREFIX:-${PROJECT_ROOT}/envs/spib}"
RUN_ID="${PBS_JOBID:-manual-probe}"
LOG_ROOT="${PROJECT_ROOT}/logs/spib"
OUTPUT_ROOT="${PROJECT_ROOT}/results/spib/${RUN_ID}"
LOG_FILE="${LOG_ROOT}/${RUN_ID}.log"

mkdir -p "${LOG_ROOT}" "${OUTPUT_ROOT}"
exec >"${LOG_FILE}" 2>&1

finish() {
    local status=$?
    trap - EXIT
    echo "exit_status=${status}"
    echo "finished_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    exit "${status}"
}
trap finish EXIT

echo "===== SPIB NSCC GPU probe ====="
echo "started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "job=${PBS_JOBID:-manual-probe}"
echo "host=$(hostname)"
echo "env=${ENV_PREFIX}"

[[ -x "${ENV_PREFIX}/bin/python" ]] || {
    echo "Missing SPIB environment: ${ENV_PREFIX}" >&2
    exit 1
}

module load "${NSCC_MINIFORGE_MODULE:-miniforge3/24.3.0}"
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${ENV_PREFIX}"

python - <<'PY'
import torch

print("torch=", torch.__version__)
print("torch_cuda_build=", torch.version.cuda)
print("cuda_available=", torch.cuda.is_available())
if not torch.cuda.is_available():
    raise SystemExit("CUDA is unavailable inside the allocated GPU job")
print("gpu=", torch.cuda.get_device_name(0))
PY
nvidia-smi --query-gpu=name,memory.total,memory.used,utilization.gpu \
    --format=csv,noheader
printf 'probe_status=success\n' >"${OUTPUT_ROOT}/probe-status.txt"
